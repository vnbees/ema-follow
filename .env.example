# Exchange selector: binance
EXCHANGE=binance

# Binance USDT-M Futures (mainnet)
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
BINANCE_API_BASE=https://fapi.binance.com

# Trading
MARGIN_MODE=crossed
LEVERAGE=10
TRADING_ENABLED=true
ORDER_MARGIN_MIN_USDT=1

# Donchian Parallel-Trend strategy
# Donchian Channel period (bars)
DONCHIAN_PERIOD=20
# Slope lookback (bars) to detect parallel bands
DONCHIAN_SLOPE_LB=5
# Max |slope_upper - slope_lower| (%/bar) to classify as parallel
DONCHIAN_PARALLEL_TOL=0.015
# Candle interval — 15m recommended. Also drives WS kline + REST (overrides GRANULARITY).
DONCHIAN_INTERVAL=15m
GRANULARITY=15m
INTERVAL_MINUTES=15
# Margin per lot as fraction of equity (0.01 = 1%), then × size_mult when SIZE_BY_RR
DONCHIAN_MARGIN_PCT=0.01
# Entry quality filter (body_size_rr05) — match backtest config D
DONCHIAN_ATR_PERIOD=14
DONCHIAN_MIN_BODY_ATR=0.3
DONCHIAN_MAX_BODY_ATR=1.2
DONCHIAN_MIN_POT_RR=0.5
DONCHIAN_SIZE_BY_RR=true
# Counter-candle volume: quote_volume / SMA(20) on 15m closed bars (0 = off)
DONCHIAN_MIN_VOL_RATIO=1.2
DONCHIAN_VOL_RATIO_PERIOD=20
# Portfolio limits — match backtest Config A
DONCHIAN_MAX_OPEN=10
DONCHIAN_TOP_K=5
DONCHIAN_MARGIN_CAP_PCT=0.15
# SMC liquidity sweep — live strategy. Donchian cycle stays in the code for /donchian.
# true: one shared futures book, 10% equity per coin, swing-50 failed-sweep limits.
# Live: 5m fade vs in-progress 4h color (20 majors). Turns off Supertrend 4h, SMC, Donchian.
FADE5M_ENABLED=false
# Binance Prediction 5m/15m/1h BTC/ETH/BNB (SQZ gray + candle label). Code ready, default off.
PREDICT5M_ENABLED=false
PREDICT5M_TRADING_ENABLED=false
PREDICT5M_STAKE_USDT=1
PREDICT5M_TARGET_USDT=2
PREDICT5M_WIN_PROFIT_MULT=2
PREDICT5M_PAUSE_SEC=3600
PREDICT5M_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT
PREDICT5M_TIMEFRAMES=5m,15m,1h
# Live list = coins whose 1 USDT × 10x sizes to ~1 USDT (no BTC/ETH min-lot).
# FADE5M_SYMBOLS=SOLUSDT,XRPUSDT,DOGEUSDT,...
FADE5M_MARGIN_USDT=1
# FADE5M_START_AT=2026-10-20 23:00
# FADE5M_LIVE_NOW=
# FADE5M_SWITCH_AT=2026-10-21 07:00
# FADE5M_SYMBOLS_NEXT=XRPUSDT,DOGEUSDT,SUIUSDT,XLMUSDT,ATOMUSDT
# 4h Supertrend(10,3)+ADX>=25 on 20 majors when fade5m is off.
TREND4H_ENABLED=true
TREND4H_MARGIN_USDT=1
TREND4H_ADX_MIN=25
SMC_ENABLED=false
# Dual limit: every signal → post-only LONG at bid + SHORT at ask (replaces market entry).
# No lot cap; MAX_COINS caps distinct coins. MAX_OPEN / TOP_K only apply when this is false.
DONCHIAN_DUAL_LIMIT=true
DONCHIAN_MAX_COINS=10
DONCHIAN_ENTRY_TTL_BARS=1
DONCHIAN_MAKER_FEE_RATE=0.0002
# Top-N symbols by 24h quote volume (only when DONCHIAN_SCAN_MODE=volume)
DONCHIAN_TOP_N=30
# Scan pool: fixed = 20 majors giống backtest (default); volume = top-N động theo vol
DONCHIAN_SCAN_MODE=fixed
# Override list (optional). Default = BT SYMBOLS_20 trong config.py
# DONCHIAN_FIXED_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT,TRXUSDT,...
# Symbol filter (volume mode only; fixed pool = off). Open lots kept.
DONCHIAN_SYMBOL_FILTER=false
DONCHIAN_MIN_LISTING_DAYS=365
DONCHIAN_MAX_RANGE_24H_PCT=15
# Majors bypass 24h range cap only (still need ≥365d listing). Default = blue-chip
# non-meme list in src/donchian/config.py. Example override:
# DONCHIAN_MAJOR_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT
# Close watcher interval (seconds)
DONCHIAN_WATCHER_INTERVAL_SEC=2

# Binance optional REST at start
# boot_optional_rest_slot: serialize one REST warmup per symbol, wait this many seconds between them.
REST_BOOT_QUIET_SEC=0
REST_BOOT_GAP_SEC=60
# REST_WEIGHT_SAFE_MAX=800
# REST_WEIGHT_HARD_MAX=1800

# App
WEB_PORT=8080
DATABASE_PATH=data/bot.db

# Dashboard login
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
DASHBOARD_SESSION_SECRET=
DASHBOARD_COOKIE_SECURE=false

DISCORD_WEBHOOK_URL=

# Coins Signal website (Railway). Empty SIGNAL_API_URL = disabled.
# Publishes open/close with equity % only — never size / margin USDT.
SIGNAL_API_URL=
SIGNAL_API_KEY=

# Daily futures → spot skim (07:00 Asia/Ho_Chi_Minh)
# Vốn gốc (dashboard: futures equity + đã rút spot ≥ vốn gốc)
INITIAL_CAPITAL=1000
SPOT_TRANSFER_ENABLED=true
SPOT_TRANSFER_MODE=skim
SPOT_TRANSFER_SKIM=0.4
SPOT_TRANSFER_DAY_CAP_PCT=1.5
SPOT_TRANSFER_DD_PAUSE_PCT=20
SPOT_TRANSFER_EXECUTE_HHMM=0700
# Discord + dashboard warnings — only when DD or maint > 50%
SPOT_WARN_DD_PCT=50
SPOT_WARN_MAINT_PCT=50
SPOT_WARN_COOLDOWN_SEC=3600
