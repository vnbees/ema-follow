# Exchange selector: bitget | binance
EXCHANGE=binance

# Bitget API credentials
BITGET_API_KEY=
BITGET_SECRET_KEY=
BITGET_PASSPHRASE=

# Binance USDT-M Futures (mainnet)
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
BINANCE_API_BASE=https://fapi.binance.com

# Trading
SYMBOL=LINKUSDT
ORDER_MARGIN_MIN_USDT=1
MARGIN_MODE=crossed
LEVERAGE=10
TRADING_ENABLED=true

# RSI-anchor mean reversion (5m). Comma-separated.
RSI_REV_SYMBOLS=LINKUSDT,SUIUSDT,WLDUSDT,HYPEUSDT
RSI_REV_RSI_PERIOD=14
RSI_REV_MID_LOW=48
RSI_REV_MID_HIGH=52
RSI_REV_MOVE_AWAY_PCT=0.005
RSI_REV_ZONE_PCT=0.0025
# Skip open if remaining entry→TP < this (0.12% covers ~0.10% RT fee + buffer).
RSI_REV_MIN_TP_ROOM_PCT=0.0012
RSI_REV_BE_AFTER_HOURS=168
RSI_REV_MAX_AGE_DAYS=30
RSI_REV_MARGIN_PCT=0.5
RSI_REV_MARGIN_MIN_USDT=1
# 0 = no cap (match backtest peak ~55). Set >0 only if you accept missing signals.
RSI_REV_MAX_OPEN=0
# 0 = open every trigger on the closed 5m candle.
RSI_REV_ENTRIES_PER_CYCLE=0
RSI_REV_CANDLE_LIMIT=200
RSI_REV_WATCHER_INTERVAL_SEC=2

GRANULARITY=5m
INTERVAL_MINUTES=5
CANDLE_LIMIT=200

# Binance optional REST at start: 0 = no 10-min blanket pause.
# One listenKey/kline/account call, then wait REST_BOOT_GAP_SEC. Skip if used-weight >= 800.
REST_BOOT_QUIET_SEC=0
REST_BOOT_GAP_SEC=60
# REST_WEIGHT_SAFE_MAX=800
# REST_WEIGHT_HARD_MAX=1800

# App
WEB_PORT=8080
DATABASE_PATH=data/bot.db

# Dashboard login
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
DASHBOARD_SESSION_SECRET=
DASHBOARD_COOKIE_SECURE=false

DISCORD_WEBHOOK_URL=
